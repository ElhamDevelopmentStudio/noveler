# API Service Configuration
PROJECT_NAME="Novelova API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="novelova"
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/novelova"
USE_SQLITE_FALLBACK=true

# Redis Configuration (Optional / Caching / Queue)
REDIS_HOST="localhost"
REDIS_PORT=6379

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Frontend (Vite) Configuration
VITE_API_BASE_URL="http://localhost:8000/api/v1"


R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=novelova
R2_REGION=auto
R2_ENDPOINT_URL=https://KEY.r2.cloudflarestorage.com

# DeepSeek LLM (Stage B Attribution Engine)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# Kaggle Production Multi-Account Pool (Stage C Audio Synthesis)
# Add as many accounts as needed: KAGGLE_ACCOUNT_1_*, KAGGLE_ACCOUNT_2_*, etc.
KAGGLE_ACCOUNT_1_USERNAME=""
KAGGLE_ACCOUNT_1_KEY=""
KAGGLE_ACCOUNT_1_PRIORITY=1

KAGGLE_ACCOUNT_2_USERNAME=""
KAGGLE_ACCOUNT_2_KEY=""
KAGGLE_ACCOUNT_2_PRIORITY=2

KAGGLE_ACCOUNT_3_USERNAME=""
KAGGLE_ACCOUNT_3_KEY=""
KAGGLE_ACCOUNT_3_PRIORITY=3

# Optional: Alternatively define the pool as a single JSON array string
# KAGGLE_ACCOUNTS_JSON='[{"username":"runner1","key":"token1","priority":1},{"username":"runner2","key":"token2","priority":2}]'

# Kaggle Orchestrator Parameters
KAGGLE_POLL_INTERVAL_SECONDS=45
KAGGLE_MAX_KERNEL_RUNTIME_MINUTES=360


