# API Service Configuration
PROJECT_NAME="Novelova API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="novelova"
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/novelova"
USE_SQLITE_FALLBACK=true

# Redis Configuration (Optional / Caching / Queue)
REDIS_HOST="localhost"
REDIS_PORT=6379

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Frontend (Vite) Configuration
VITE_API_BASE_URL="http://localhost:8000/api/v1"


R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=novelova
R2_REGION=auto
R2_ENDPOINT_URL=https://KEY.r2.cloudflarestorage.com

