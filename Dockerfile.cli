# ==============================================================================
# Novelova CLI & AI Agent Minimal Runtime Container
# ==============================================================================
FROM python:3.12-slim-bookworm AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency management
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

COPY pyproject.toml uv.lock ./
COPY packages/python-core ./packages/python-core
COPY packages/novelova-cli ./packages/novelova-cli

# Install dependencies and build standalone binary
RUN uv sync --frozen || uv sync
RUN uv run python packages/novelova-cli/scripts/build_binary.py

# ==============================================================================
# Production Minimal Image
# ==============================================================================
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy prebuilt binary from builder
COPY --from=builder /build/dist/novelova /usr/local/bin/novelova
RUN chmod +x /usr/local/bin/novelova

# Create unprivileged runner user
RUN useradd -m -u 1000 novelova
USER novelova
WORKDIR /home/novelova

ENV NOVELOVA_API_BASE_URL="http://localhost:8000/api/v1"

ENTRYPOINT ["novelova"]
CMD ["--help"]
